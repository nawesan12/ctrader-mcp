# ---- cTrader Open API (https://openapi.ctrader.com) ----
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Only used to bootstrap the token store on first start; after that SQLite (DATA_DIR) is the source of truth.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# ctidTraderAccountId of the DEMO account. Empty = auto-select if the token has exactly one demo account.
CTRADER_ACCOUNT_ID=
# Only "demo" is allowed in this version.
CTRADER_ENV=demo

# ---- MCP server auth (at least one of the two) ----
# Static bearer for Claude Code (`claude mcp add --header`) or claude.ai orgs with the request-headers beta.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Password you type on the consent page when adding the server as a claude.ai custom connector (OAuth). >= 16 chars.
OAUTH_OWNER_PASSWORD=
# Public HTTPS URL of this server (required for OAuth). The MCP endpoint is <PUBLIC_URL>/mcp
PUBLIC_URL=https://mcp.example.com
# Extra OAuth redirect URIs allowed at client registration (comma separated). Claude's and loopback are built in.
OAUTH_EXTRA_REDIRECT_URIS=
# Optional Origin allowlist for /mcp (comma separated). Empty = not checked (auth is still required).
MCP_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=120

# ---- HTTP ----
HOST=0.0.0.0
PORT=8787
# 1 when behind Caddy/cloudflared (docker-compose sets it).
TRUST_PROXY=0
DATA_DIR=./data
LOG_LEVEL=info

# ---- Deploy (docker compose) ----
# Caddy profile: domain whose DNS points to the VPS.
MCP_DOMAIN=mcp.example.com
# Tunnel profile: token from Cloudflare Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Risk ----
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_RISK_PCT=2
MAX_TRADES_PER_SYMBOL_PER_DAY=3
DAILY_LOSS_LIMIT_PCT=2
ALLOWED_SYMBOLS=EURUSD,USDJPY,EURGBP,GBPUSD,XAUUSD
TZ_SESSIONS=America/New_York
